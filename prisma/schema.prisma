generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id                   String                    @id @default(cuid())
  name                 String?
  username             String                    @unique
  email                String                    @unique
  password             String
  image                String?                   @db.LongText
  role                 Role                      @default(USER)
  createdAt            DateTime                  @default(now())
  updatedAt            DateTime                  @updatedAt
  banner               String?                   @db.LongText
  bio                  String?                   @db.Text
  socialLinks          String?                   @db.Text
  geminiApiKey         String?                   @db.Text
  balance              Float                     @default(0)
  tags                 String?                   @db.Text
  pushSubscription     Json?
  lastSeen             DateTime?                 @default(now())
  notificationSettings String?                   @db.Text
  level                Int                       @default(1)
  xp                   Int                       @default(0)
  ink                  Int                       @default(0)
  activities           Activity[]
  books                Book[]
  bookCollaborators    BookCollaborator[]
  bookmarks            Bookmark[]
  chatSessions         ChatSession[]
  comments             Comment[]
  commentReactions     CommentReaction[]
  communities          Community[]               @relation("CreatedCommunities")
  joinedCommunities    CommunityMember[]
  conversations        ConversationParticipant[]
  messages             DirectMessage[]
  following            Follow[]                  @relation("Follower")
  followers            Follow[]                  @relation("Following")
  receivedGifts        Gift[]                    @relation("ReceivedGifts")
  sentGifts            Gift[]                    @relation("SentGifts")
  likes                Like[]
  messageReactions     MessageReaction[]
  notifications        Notification[]
  posts                Post[]
  postLikes            PostLike[]
  purchases            Purchase[]
  sales                Purchase[]                @relation("Seller")
  readingLists         ReadingList[]
  readingProgress      ReadingProgress[]
  hostedRooms          ReadingRoom[]
  readingRoomMessages  ReadingRoomMessage[]
  joinedRooms          ReadingRoomParticipant[]
  readingSessions      ReadingSession[]
  redemptionCodes      RedemptionCode[]
  reports              Report[]
  reviews              Review[]
  statuses             Status[]
  subscription         Subscription?
  receivedTips         Tip[]                     @relation("ReceivedTips")
  sentTips             Tip[]                     @relation("SentTips")
  userAchievements     UserAchievement[]
  items                UserItem[]
}

model Item {
  id              String           @id @default(cuid())
  name            String
  description     String
  price           Float
  type            String
  rarity          String
  data            Json?
  createdAt       DateTime         @default(now())
  redemptionCodes RedemptionCode[]
  users           UserItem[]
}

model UserItem {
  id         String   @id @default(cuid())
  userId     String
  itemId     String
  equipped   Boolean  @default(false)
  acquiredAt DateTime @default(now())
  item       Item     @relation(fields: [itemId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, itemId])
  @@index([userId])
  @@index([itemId])
}

model Status {
  id        String   @id @default(cuid())
  userId    String
  type      String
  data      Json
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Conversation {
  id           String                    @id @default(cuid())
  createdAt    DateTime                  @default(now())
  updatedAt    DateTime                  @updatedAt
  typingAt     DateTime?
  typingUserId String?
  participants ConversationParticipant[]
  messages     DirectMessage[]
}

model ConversationParticipant {
  id             String       @id @default(cuid())
  userId         String
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, conversationId])
  @@index([userId])
  @@index([conversationId])
}

model DirectMessage {
  id             String            @id @default(cuid())
  content        String            @db.Text
  senderId       String
  conversationId String
  createdAt      DateTime          @default(now())
  read           Boolean           @default(false)
  mediaType      String?
  mediaUrl       String?           @db.LongText
  giftId         String?
  editedAt       DateTime?
  replyToId      String?
  conversation   Conversation      @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  gift           Gift?             @relation(fields: [giftId], references: [id])
  replyTo        DirectMessage?    @relation("ReplyTo", fields: [replyToId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  replies        DirectMessage[]   @relation("ReplyTo")
  sender         User              @relation(fields: [senderId], references: [id], onDelete: Cascade)
  reactions      MessageReaction[]

  @@index([conversationId])
  @@index([senderId])
  @@index([replyToId])
  @@index([giftId], map: "DirectMessage_giftId_fkey")
}

model MessageReaction {
  id        String        @id @default(cuid())
  messageId String
  userId    String
  type      String
  createdAt DateTime      @default(now())
  message   DirectMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId, type])
  @@index([messageId])
  @@index([userId])
}

model PostLike {
  id        String   @id @default(cuid())
  postId    String
  userId    String
  createdAt DateTime @default(now())
  type      String   @default("HEART")
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
  @@index([postId])
  @@index([userId])
}

model Achievement {
  id            String            @id @default(cuid())
  name          String
  description   String
  icon          String
  criteriaType  String
  criteriaValue Int
  xpReward      Int
  createdAt     DateTime          @default(now())
  users         UserAchievement[]
}

model UserAchievement {
  id            String      @id @default(cuid())
  userId        String
  achievementId String
  unlockedAt    DateTime    @default(now())
  achievement   Achievement @relation(fields: [achievementId], references: [id])
  user          User        @relation(fields: [userId], references: [id])

  @@unique([userId, achievementId])
  @@index([userId])
  @@index([achievementId])
}

model Purchase {
  id        String   @id @default(cuid())
  bookId    String
  buyerId   String
  sellerId  String
  amount    Float
  createdAt DateTime @default(now())
  book      Book     @relation(fields: [bookId], references: [id])
  buyer     User     @relation(fields: [buyerId], references: [id])
  seller    User     @relation("Seller", fields: [sellerId], references: [id])

  @@index([bookId])
  @@index([buyerId])
  @@index([sellerId])
}

model Book {
  id               String             @id @default(cuid())
  title            String
  description      String             @db.Text
  coverImage       String?            @db.LongText
  content          String             @db.LongText
  price            Float              @default(0)
  isPremium        Boolean            @default(false)
  published        Boolean            @default(false)
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  authorId         String
  genre            String?
  allowDownload    Boolean            @default(false)
  ambience         String?
  tags             String?            @db.Text
  author           User               @relation(fields: [authorId], references: [id])
  collaborators    BookCollaborator[]
  pages            BookPage[]
  bookmarks        Bookmark[]
  characters       Character[]
  likes            Like[]
  purchases        Purchase[]
  readingListBooks ReadingListBook[]
  readingProgress  ReadingProgress[]
  readingRooms     ReadingRoom[]
  readingSessions  ReadingSession[]
  reviews          Review[]
  weeklyFree       WeeklyFree[]

  @@index([authorId], map: "Book_authorId_fkey")
}

model BookCollaborator {
  id        String   @id @default(cuid())
  bookId    String
  userId    String
  role      String   @default("EDITOR")
  createdAt DateTime @default(now())
  book      Book     @relation(fields: [bookId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id])

  @@unique([bookId, userId])
  @@index([bookId])
  @@index([userId])
}

model BookPage {
  id          String    @id @default(cuid())
  title       String?
  content     String    @db.LongText
  pageNumber  Int
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  bookId      String
  scheduledAt DateTime?
  book        Book      @relation(fields: [bookId], references: [id], onDelete: Cascade)

  @@unique([bookId, pageNumber])
  @@index([bookId], map: "BookPage_bookId_fkey")
}

model Subscription {
  id        String   @id @default(cuid())
  userId    String   @unique
  status    String
  plan      String
  startDate DateTime @default(now())
  endDate   DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id])
}

model Like {
  id        String   @id @default(cuid())
  bookId    String
  userId    String
  createdAt DateTime @default(now())
  book      Book     @relation(fields: [bookId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([bookId, userId])
  @@index([bookId])
  @@index([userId])
}

model Review {
  id        String   @id @default(cuid())
  rating    Int
  content   String?  @db.Text
  createdAt DateTime @default(now())
  bookId    String
  userId    String
  book      Book     @relation(fields: [bookId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([bookId, userId])
  @@index([bookId])
  @@index([userId])
}

model Follow {
  id          String   @id @default(cuid())
  followerId  String
  followingId String
  createdAt   DateTime @default(now())
  follower    User     @relation("Follower", fields: [followerId], references: [id], onDelete: Cascade)
  following   User     @relation("Following", fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId])
  @@index([followerId])
  @@index([followingId])
}

model Tip {
  id               String               @id @default(cuid())
  amount           Float
  message          String?              @db.Text
  createdAt        DateTime             @default(now())
  senderId         String
  receiverId       String
  sentRoomMessages ReadingRoomMessage[]
  receiver         User                 @relation("ReceivedTips", fields: [receiverId], references: [id])
  sender           User                 @relation("SentTips", fields: [senderId], references: [id])

  @@index([senderId])
  @@index([receiverId])
}

model Community {
  id          String            @id @default(cuid())
  name        String
  description String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  creatorId   String
  privacy     String            @default("OPEN")
  creator     User              @relation("CreatedCommunities", fields: [creatorId], references: [id])
  members     CommunityMember[]
  posts       Post[]

  @@index([creatorId], map: "Community_creatorId_fkey")
}

model CommunityMember {
  id          String    @id @default(cuid())
  userId      String
  communityId String
  joinedAt    DateTime  @default(now())
  role        String    @default("MEMBER")
  status      String    @default("APPROVED")
  community   Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id])

  @@unique([userId, communityId])
  @@index([communityId], map: "CommunityMember_communityId_fkey")
}

model Post {
  id          String     @id @default(cuid())
  content     String     @db.Text
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  communityId String
  authorId    String
  mediaType   String?
  mediaUrl    String?    @db.LongText
  comments    Comment[]
  author      User       @relation(fields: [authorId], references: [id])
  community   Community  @relation(fields: [communityId], references: [id])
  likes       PostLike[]

  @@index([authorId], map: "Post_authorId_fkey")
  @@index([communityId], map: "Post_communityId_fkey")
}

model Comment {
  id        String            @id @default(cuid())
  content   String            @db.Text
  createdAt DateTime          @default(now())
  postId    String
  authorId  String
  author    User              @relation(fields: [authorId], references: [id])
  post      Post              @relation(fields: [postId], references: [id], onDelete: Cascade)
  reactions CommentReaction[]

  @@index([authorId], map: "Comment_authorId_fkey")
  @@index([postId], map: "Comment_postId_fkey")
}

model CommentReaction {
  id        String   @id @default(cuid())
  commentId String
  userId    String
  type      String
  createdAt DateTime @default(now())
  comment   Comment  @relation(fields: [commentId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([commentId, userId, type])
  @@index([commentId])
  @@index([userId])
}

model WeeklyFree {
  id        String   @id @default(cuid())
  bookId    String
  startDate DateTime
  endDate   DateTime
  createdAt DateTime @default(now())
  book      Book     @relation(fields: [bookId], references: [id])

  @@index([bookId], map: "WeeklyFree_bookId_fkey")
}

model Character {
  id           String        @id @default(cuid())
  name         String
  description  String        @db.Text
  personality  String        @db.Text
  avatar       String?       @db.LongText
  bookId       String
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  book         Book          @relation(fields: [bookId], references: [id], onDelete: Cascade)
  chatSessions ChatSession[]

  @@index([bookId])
}

model ChatSession {
  id          String        @id @default(cuid())
  userId      String
  characterId String
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  messages    ChatMessage[]
  character   Character     @relation(fields: [characterId], references: [id], onDelete: Cascade)
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([characterId])
}

model ChatMessage {
  id        String      @id @default(cuid())
  sessionId String
  role      String
  content   String      @db.Text
  createdAt DateTime    @default(now())
  session   ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
}

model ReadingProgress {
  id             String   @id @default(cuid())
  userId         String
  bookId         String
  pageNumber     Int      @default(1)
  scrollPosition Float    @default(0)
  updatedAt      DateTime @updatedAt
  totalTimeRead  Int      @default(0)
  book           Book     @relation(fields: [bookId], references: [id], onDelete: Cascade)
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, bookId])
  @@index([bookId])
}

model ReadingSession {
  id        String    @id @default(cuid())
  userId    String
  bookId    String
  startTime DateTime  @default(now())
  endTime   DateTime?
  pagesRead Int       @default(0)
  book      Book      @relation(fields: [bookId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([bookId])
}

model Bookmark {
  id         String   @id @default(cuid())
  userId     String
  bookId     String
  pageNumber Int
  note       String?  @db.Text
  createdAt  DateTime @default(now())
  book       Book     @relation(fields: [bookId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([bookId])
}

model ReadingRoom {
  id           String                   @id @default(cuid())
  hostId       String
  bookId       String
  currentPage  Int                      @default(1)
  status       String                   @default("ACTIVE")
  createdAt    DateTime                 @default(now())
  book         Book                     @relation(fields: [bookId], references: [id])
  host         User                     @relation(fields: [hostId], references: [id])
  messages     ReadingRoomMessage[]
  participants ReadingRoomParticipant[]

  @@index([hostId])
  @@index([bookId])
}

model ReadingRoomMessage {
  id        String      @id @default(cuid())
  roomId    String
  userId    String
  content   String      @db.Text
  createdAt DateTime    @default(now())
  tipId     String?
  room      ReadingRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  tip       Tip?        @relation(fields: [tipId], references: [id])
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([roomId])
  @@index([userId])
  @@index([tipId], map: "ReadingRoomMessage_tipId_fkey")
}

model ReadingRoomParticipant {
  id       String      @id @default(cuid())
  roomId   String
  userId   String
  joinedAt DateTime    @default(now())
  room     ReadingRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user     User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([roomId, userId])
  @@index([userId])
}

model Activity {
  id        String   @id @default(cuid())
  userId    String
  type      String
  entityId  String
  metadata  Json?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  type      String
  message   String
  read      Boolean  @default(false)
  link      String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model RedemptionCode {
  id        String    @id @default(cuid())
  code      String    @unique
  itemId    String
  isUsed    Boolean   @default(false)
  usedBy    String?
  createdAt DateTime  @default(now())
  usedAt    DateTime?
  item      Item      @relation(fields: [itemId], references: [id])
  user      User?     @relation(fields: [usedBy], references: [id])

  @@index([itemId])
  @@index([usedBy])
}

model Gift {
  id         String          @id @default(cuid())
  senderId   String
  receiverId String
  type       String
  data       Json
  status     String          @default("PENDING")
  createdAt  DateTime        @default(now())
  expiresAt  DateTime
  message    DirectMessage[]
  receiver   User            @relation("ReceivedGifts", fields: [receiverId], references: [id])
  sender     User            @relation("SentGifts", fields: [senderId], references: [id])

  @@index([senderId])
  @@index([receiverId])
}

model Report {
  id          String    @id @default(cuid())
  reporterId  String
  contentType String
  contentId   String
  reason      String
  details     String?   @db.Text
  status      String    @default("PENDING")
  action      String?
  resolvedAt  DateTime?
  resolvedBy  String?
  createdAt   DateTime  @default(now())
  reporter    User      @relation(fields: [reporterId], references: [id], onDelete: Cascade)

  @@index([reporterId])
  @@index([status])
  @@index([contentType, contentId])
}

model ReadingList {
  id        String            @id @default(cuid())
  name      String
  icon      String?
  color     String?
  isDefault Boolean           @default(false)
  userId    String
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  books     ReadingListBook[]

  @@index([userId])
}

model ReadingListBook {
  id      String      @id @default(cuid())
  listId  String
  bookId  String
  addedAt DateTime    @default(now())
  note    String?     @db.Text
  book    Book        @relation(fields: [bookId], references: [id], onDelete: Cascade)
  list    ReadingList @relation(fields: [listId], references: [id], onDelete: Cascade)

  @@unique([listId, bookId])
  @@index([listId])
  @@index([bookId])
}

model WritingBattle {
  id        String    @id @default(cuid())
  theme     String
  status    String
  startTime DateTime
  endTime   DateTime?
  createdAt DateTime  @default(now())
}

model BattleParticipant {
  id        String   @id @default(cuid())
  userId    String
  battleId  String
  content   String?  @db.Text
  createdAt DateTime @default(now())
}

model BattleVote {
  id            String   @id @default(cuid())
  voterId       String
  battleId      String
  participantId String
  createdAt     DateTime @default(now())
}

model AuthorCosmetic {
  id          String   @id @default(cuid())
  authorId    String
  name        String
  description String?
  type        String
  image       String   @db.LongText
  price       Int
  isPublic    Boolean  @default(false)
  createdAt   DateTime @default(now())
}

model UserCosmetic {
  id          String   @id @default(cuid())
  userId      String
  cosmeticId  String
  equipped    Boolean  @default(false)
  purchasedAt DateTime @default(now())
}

enum Role {
  USER
  ADMIN
}
